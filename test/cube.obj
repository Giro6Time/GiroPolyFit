# 立方体的顶点定义
v  1.0  1.0  1.0    # 顶点 1
v -1.0  1.0  1.0    # 顶点 2
v -1.0 -1.0  1.0    # 顶点 3
v  1.0 -1.0  1.0    # 顶点 4
v  1.0  1.0 -1.0    # 顶点 5
v -1.0  1.0 -1.0    # 顶点 6
v -1.0 -1.0 -1.0    # 顶点 7
v  1.0 -1.0 -1.0    # 顶点 8

# 立方体的面定义（每个面由两个三角形组成）
f 1 2 3
f 1 3 4
f 1 5 2
f 2 5 6
f 6 5 8
f 6 8 7
f 4 7 8
f 3 7 4
f 3 2 6
f 3 6 7
f 1 4 8
f 1 8 5